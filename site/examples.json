{
 "diagrams": [
  [
   "how-giotto-works",
   {
    "title": "How Giotto works",
    "subtitle": "Your agent draws, you watch and point",
    "scenes": [
     {
      "label": "Draw",
      "beats": [
       {
        "edges": {
         "edge": "a1",
         "data": "add 4 boxes, 3 arrows"
        },
        "say": "You ask for a diagram. Your agent already knows your code, so it calls Giotto."
       },
       {
        "edges": "a2",
        "light": [
         "files"
        ],
        "say": "Giotto lays it out and saves it as a new version."
       },
       {
        "edges": "a3",
        "show": {
         "canvas": [
          {
           "tag": "new",
           "tone": "green",
           "text": "4 boxes, 3 arrows"
          }
         ]
        },
        "say": "The canvas updates live. No reload, no export."
       }
      ]
     },
     {
      "label": "Point",
      "beats": [
       {
        "light": [
         "canvas"
        ],
        "show": {
         "canvas": [
          {
           "tag": "area",
           "tone": "yellow",
           "text": "make this bigger"
          }
         ]
        },
        "say": "You drag over a part of the diagram and say what should change."
       },
       {
        "edges": {
         "edge": "a4",
         "data": "requested changes (1)"
        },
        "say": "Copy the requests and paste them to your agent: it knows exactly which boxes you mean."
       },
       {
        "edges": "a1",
        "say": "It edits just those boxes, in small steps."
       }
      ]
     },
     {
      "label": "Ship",
      "beats": [
       {
        "edges": {
         "edge": "a1",
         "data": "export svg"
        },
        "light": [
         "mcp"
        ],
        "say": "When it looks right, export it: SVG, PNG, or an animated SVG that plays in a README."
       }
      ]
     }
    ],
    "speed": 2600,
    "elements": [
     {
      "id": "root",
      "type": "group",
      "children": [
       "agent",
       "mcp",
       "files",
       "canvas"
      ],
      "layout": {
       "direction": "row",
       "gap": 70,
       "align": "center"
      }
     },
     {
      "id": "agent",
      "type": "rectangle",
      "tone": "purple",
      "content": [
       {
        "type": "title",
        "text": "Your agent"
       },
       {
        "type": "text",
        "text": "Claude Code, Codex, ChatGPT"
       }
      ]
     },
     {
      "id": "mcp",
      "type": "rectangle",
      "tone": "blue",
      "content": [
       {
        "type": "title",
        "text": "Giotto MCP"
       },
       {
        "type": "chips",
        "items": [
         "create",
         "edit",
         "export",
         "styles"
        ]
       }
      ]
     },
     {
      "id": "files",
      "type": "cylinder",
      "tone": "gray",
      "content": [
       {
        "type": "title",
        "text": "~/.giotto"
       },
       {
        "type": "text",
        "text": "one JSON file per diagram, every version kept"
       }
      ]
     },
     {
      "id": "canvas",
      "type": "rectangle",
      "tone": "green",
      "content": [
       {
        "type": "title",
        "text": "The canvas"
       },
       {
        "type": "text",
        "text": "live in your browser"
       }
      ]
     },
     {
      "id": "a1",
      "type": "arrow",
      "start": {
       "id": "agent"
      },
      "end": {
       "id": "mcp"
      },
      "label": {
       "text": "tool calls"
      }
     },
     {
      "id": "a2",
      "type": "arrow",
      "start": {
       "id": "mcp"
      },
      "end": {
       "id": "files"
      },
      "label": {
       "text": "writes"
      }
     },
     {
      "id": "a3",
      "type": "arrow",
      "start": {
       "id": "files"
      },
      "end": {
       "id": "canvas"
      },
      "label": {
       "text": "live"
      }
     },
     {
      "id": "a4",
      "type": "arrow",
      "start": {
       "id": "canvas"
      },
      "end": {
       "id": "agent"
      },
      "around": "below",
      "label": {
       "text": "requested changes"
      },
      "quiet": true
     },
     {
      "id": "n1",
      "type": "note",
      "text": "No coordinates: groups lay boxes out, arrows route themselves.",
      "attachTo": "mcp",
      "side": "top"
     }
    ],
    "selectedIds": [],
    "legend": {
     "items": [
      {
       "tone": "purple",
       "text": "your agent"
      },
      {
       "tone": "blue",
       "text": "Giotto"
      },
      {
       "tone": "green",
       "text": "what you see"
      }
     ]
    }
   }
